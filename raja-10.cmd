@echo off
title RAJA ACTIVATOR - Fixed Edition
color 07
setlocal EnableDelayedExpansion

:: --- Admin Check ---
fltmc >nul 2>&1 || (
    echo [!] Admin rights required!
    pause
    exit /b
)

:: --- Internet Check ---
ping -n 1 8.8.8.8 >nul 2>&1
if errorlevel 1 (
    echo [!] Internet required!
    pause
    exit /b
)

:: --- Detect Windows Edition & Correct SKU Format ---
for /f "tokens=2 delims=[]" %%G in ('ver') do for /f "tokens=2,3,4 delims=. " %%H in ("%%~G") do set "winbuild=%%J"

for /f "skip=2 tokens=2*" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v ProductName 2^>nul') do set "winedition=%%b"
if %winbuild% GEQ 22000 set "winedition=!winedition:Windows 10=Windows 11!"

:: --- Get Correct SKU and Pfn Name ---
for /f "skip=2 tokens=3" %%a in ('reg query "HKLM\SYSTEM\CurrentControlSet\Control\ProductOptions" /v OSProductPfn 2^>nul') do set "sku=%%a"

:: Map SKU to correct Pfn name
set "pfn="
if "%sku%"=="48" set "pfn=Professional"
if "%sku%"=="49" set "pfn=ProfessionalN"
if "%sku%"=="101" set "pfn=Core"
if "%sku%"=="98" set "pfn=CoreN"
if "%sku%"=="121" set "pfn=Education"
if "%sku%"=="122" set "pfn=EducationN"
if "%sku%"=="4" set "pfn=Enterprise"
if "%sku%"=="27" set "pfn=EnterpriseN"
if "%sku%"=="161" set "pfn=ProfessionalWorkstation"
if "%sku%"=="162" set "pfn=ProfessionalWorkstationN"
if "%sku%"=="164" set "pfn=ProfessionalEducation"
if "%sku%"=="165" set "pfn=ProfessionalEducationN"
if "%sku%"=="171" set "pfn=EnterpriseG"
if "%sku%"=="172" set "pfn=EnterpriseGN"
if "%sku%"=="175" set "pfn=ServerRdsh"

:: --- Fallback: Agar pfn nahi mila toh Pro le lo ---
if not defined pfn (
    set "pfn=Professional"
    set "sku=48"
)

:: --- Set Correct Key ---
set "key="
if "%sku%"=="48" set "key=VK7JG-NPHTM-C97JM-9MPGT-3V66T"
if "%sku%"=="49" set "key=2B87N-8KFHP-DKV6R-Y2C8J-PKCKT"
if "%sku%"=="101" set "key=TX9XD-98N7V-6WMQ6-BX7FG-H8Q99"
if "%sku%"=="98" set "key=3KHY7-WNT83-DGQKR-F7HPR-84BM"
if "%sku%"=="121" set "key=YNMGQ-8RYV3-4PGQ3-C8XTP-7CFBY"
if "%sku%"=="122" set "key=84NGF-MHBT6-FXBX8-QWJK7-DRR8H"
if "%sku%"=="4" set "key=XGVPP-NMH47-7TTHJ-W3FW7-8HV2C"
if "%sku%"=="27" set "key=3V6Q6-NQXCX-V8YXR-9QCYV-QPFCT"
if "%sku%"=="161" set "key=DXG7C-N36C4-C4HTG-X4T3X-2YV77"
if "%sku%"=="162" set "key=WYPNQ-8C467-V2W6J-TX4WX-WT2RQ"
if "%sku%"=="164" set "key=8PTT6-RNW4C-6V7J2-C2D3X-MHBPB"
if "%sku%"=="165" set "key=GJTYN-HDMQY-FRR76-HVGC7-QPF8P"
if "%sku%"=="171" set "key=YYVX9-NTFWV-6MDM3-9PT4T-4M68B"
if "%sku%"=="172" set "key=44RPN-FTY23-9VTTB-MP9BX-T84FV"
if "%sku%"=="175" set "key=NJCF7-PW8QT-3324D-688JX-2YV66"

:: --- Fallback Key ---
if not defined key set "key=VK7JG-NPHTM-C97JM-9MPGT-3V66T"

cls
echo ============================================================
echo   ⚡ RAJA ACTIVATOR - Fixed Edition
echo ============================================================
echo.
echo   Detected Edition : !winedition!
echo   SKU              : %sku%
echo   Pfn Name         : !pfn!
echo   Key to use       : !key!
echo.
echo ============================================================

:: --- Check if already activated ---
set _perm=
powershell -nop -c "(([WMISEARCHER]'SELECT Name FROM SoftwareLicensingProduct WHERE LicenseStatus=1 AND GracePeriodRemaining=0 AND PartialProductKey IS NOT NULL AND LicenseDependsOn is NULL').Get()).Name" 2>nul | findstr /i "Windows" >nul && set _perm=1

if defined _perm (
    echo [!] Already activated!
    choice /C 10 /N /M "Press [1] to Activate Anyway, [0] to Exit: "
    if errorlevel 2 exit /b
)

:: --- Install Correct Key ---
echo [1/4] Installing correct product key...
cscript //nologo %windir%\system32\slmgr.vbs /ipk !key! >nul

:: --- Generate GenuineTicket with CORRECT Pfn ---
echo [2/4] Generating GenuineTicket...
set "tdir=%ProgramData%\Microsoft\Windows\ClipSVC\GenuineTicket"
if not exist "%tdir%\" mkdir "%tdir%\" 2>nul
if exist "%tdir%\*" del /f /q "%tdir%\*" 2>nul

